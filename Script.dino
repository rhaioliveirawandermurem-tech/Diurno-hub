-- ============ VARIAVEIS GLOBAIS DOS MÓDULOS ============
local Config = {
    GojoActive = false,
    FlyActive = false,
    BypassActive = false,
    FocusActive = false,
    FocusTarget = nil,
}

local FlyKeys = {W=false, A=false, S=false, D=false, Up=false, Down=false}
local FlySpeed = 80

local FocusConn = nil
local FocusPart = nil
local GojoConn = nil
local BypassConn = nil

-- ============ KEY VERIFY ============
keyBtn.MouseButton1Click:Connect(function()
    if keyBox.Text == KEY_CORRETA then
        keyFrame:Destroy()
        -- Abre o hub após verificação
        _G.OpenDiurnoHub()
    else
        keyBox.Text = ""
        keyBox.PlaceholderText = "❌ Key incorreta!"
