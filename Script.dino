-- ==================== SISTEMA DE ABAS ====================  
local Abas = {}  
local AbaAtual = nil  

local function trocarAba(nomeAba)  
    for nome, dados in pairs(Abas) do  
        if nome == nomeAba then  
            dados.frame.Visible = true  
            dados.botao.BackgroundColor3 = COR_NEON  
            dados.botao.TextColor3 = COR_FUNDO  
        else  
            dados.frame.Visible = false  
            dados.botao.BackgroundColor3 = COR_FUNDO  
            dados.botao.TextColor3 = COR_TXT_DIM  
        end  
    end  
    ContentTitle.Text = nomeAba  
    AbaAtual = nomeAba  
end  

local function criarAba(nome, ordem)  
    local botao = Instance.new("TextButton")  
    botao.Size = UDim2.new(1, 0, 0, 34)  
    botao.BackgroundColor3 = COR_FUNDO  
    botao.BorderSizePixel = 0  
    botao.Text = nome  
    botao.TextColor3 = COR_TXT_DIM  
    botao.Font = Enum.Font.GothamMedium  
    botao.TextSize = 12  
    botao.LayoutOrder = ordem  
    botao.AutoButtonColor = false  
    botao.Parent = TabList  
    Instance.new("UICorner", botao).CornerRadius = UDim.new(0, 8)  

    local abaFrame = Instance.new("Frame")  
    abaFrame.Size = UDim2.new(1, 0, 0, 0)  
    abaFrame.BackgroundTransparency = 1  
    abaFrame.Visible = false  
    abaFrame.Parent = FunctionList  

    local abaLayout = Instance.new("UIListLayout")  
    abaLayout.Padding = UDim.new(0, 7)  
    abaLayout.SortOrder = Enum.SortOrder.LayoutOrder  
    abaLayout.Parent = abaFrame  

    abaLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()  
        abaFrame.Size = UDim2.new(1, 0, 0, abaLayout.AbsoluteContentSize.Y + 10)  
    end)  

    botao.MouseButton1Click:Connect(function() trocarAba(nome) end)  

    Abas[nome] = { botao = botao, frame = abaFrame }  
    if not AbaAtual then trocarAba(nome) end  
    return abaFrame  
end  

local function criarToggle(parent, texto, ordem, callback)  
    local row = Instance.new("Frame")  
    row.Size = UDim2.new(1, 0, 0, 46)  
    row.BackgroundColor3 = COR_FUNDO  
    row.BorderSizePixel = 0  
    row.LayoutOrder = ordem  
    row.Parent = parent  
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)  
    local rStroke = Instance.new("UIStroke")  
    rStroke.Color = COR_NEON  
    rStroke.Thickness = 1  
    rStroke.Transparency = 0.6  
    rStroke.Parent = row  

    local lbl = Instance.new("TextLabel")  
    lbl.Size = UDim2.new(0.72, 0, 1, 0)  
    lbl.Position = UDim2.new(0, 14, 0, 0)  
    lbl.BackgroundTransparency = 1  
    lbl.Text = texto  
    lbl.TextColor3 = Color3.fromRGB(230, 255, 235)  
    lbl.Font = Enum.Font.Gotham  
    lbl.TextSize = 13  
    lbl.TextXAlignment = Enum.TextXAlignment.Left  
    lbl.Parent = row  

    local bg = Instance.new("Frame")  
    bg.Size = UDim2.new(0, 42, 0, 24)  
    bg.Position = UDim2.new(1, -56, 0.5, -12)  
    bg.BackgroundColor3 = COR_FUNDO_2  
    bg.BorderSizePixel = 0  
    bg.Parent = row  
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)  

    local circle = Instance.new("Frame")  
    circle.Size = UDim2.new(0, 18, 0, 18)  
    circle.Position = UDim2.new(0, 3, 0.5, -9)  
    circle.BackgroundColor3 = Color3.fromRGB(150, 170, 155)  
    circle.BorderSizePixel = 0  
    circle.Parent = bg  
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)  

    local click = Instance.new("TextButton")  
    click.Size = UDim2.new(1, 0, 1, 0)  
    click.BackgroundTransparency = 1  
    click.Text = ""  
    click.Parent = row  

    local estado = false  
    click.MouseButton1Click:Connect(function()  
        estado = not estado  
        if estado then  
            bg.BackgroundColor3 = COR_NEON_ESCURO  
            circle.Position = UDim2.new(1, -21, 0.5, -9)  
            circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)  
        else  
            bg.BackgroundColor3 = COR_FUNDO_2  
            circle.Position = UDim2.new(0, 3, 0.5, -9)  
            circle.BackgroundColor3 = Color3.fromRGB(150, 170, 155)  
        end  
        if callback then pcall(callback, estado) end  
    end)  

    return row  
end  

local AbaP = criarAba("Principal", 1)  

-- ==================== GOJO 0.2 ====================  
local gojoActive = false  
local gojoConn = nil  
criarToggle(AbaP, "Gojo 0.2 (Teleport Kill)", 1, function(ativo)  
    gojoActive = ativo  
    if ativo then  
        gojoConn = task.spawn(function()  
            while gojoActive do  
                local char = LP.Character  
                local root = char and char:FindFirstChild("HumanoidRootPart")  
                if root then  
                    for _, p in ipairs(Players:GetPlayers()) do  
                        if not gojoActive then break end  
                        if p ~= LP and p.Character then  
                            local tr  = p.Character:FindFirstChild("HumanoidRootPart")  
                            local hum = p.Character:FindFirstChildOfClass("Humanoid")  
                            if tr and hum and hum.Health > 0 then  
                                root.CFrame = tr.CFrame  
                                RunService.Heartbeat:Wait()  
                            end  
                        end  
                    end  
                end  
                RunService.Heartbeat:Wait()  
            end  
        end)  
    else  
        if gojoConn then task.cancel(gojoConn); gojoConn = nil end  
    end  
end)  

-- ==================== FLY MOBILE ====================  
local flyAtivo = false  
local flyConn = nil  
local direcoes = {cima=false, baixo=false, esq=false, dir=false, subir=false, descer=false}  
local flyGuiRefs = {}  

local function DestruirControlesFly()  
    for _, gui in pairs(flyGuiRefs) do pcall(function() gui:Destroy() end) end  
    flyGuiRefs = {}  
end  

local function CriarControlesFly()  
    local sg = Instance.new("ScreenGui")  
    sg.Name = "DinoFlyControls"  
    sg.ResetOnSpawn = false  
    sg.Parent = CoreGui  
    table.insert(flyGuiRefs, sg)  

    local screenH = workspace.CurrentCamera.ViewportSize.Y  

    local function CriarSeta(pos, texto, dirNome)  
        local b = Instance.new("TextButton")  
        b.Size = UDim2.new(0, 60, 0, 60)  
        b.Position = pos  
        b.BackgroundColor3 = COR_FUNDO  
        b.BackgroundTransparency = 0.2  
        b.Text = texto  
        b.TextColor3 = COR_NEON  
        b.Font = Enum.Font.GothamBold  
        b.TextSize = 26  
        b.BorderSizePixel = 0  
        b.Parent = sg  
        b.AutoButtonColor = false  
        local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 12) c.Parent = b  
        local s = Instance.new("UIStroke") s.Color = COR_NEON s.Thickness = 2 s.Parent = b  

        b.MouseButton1Down:Connect(function() direcoes[dirNome] = true; b.BackgroundColor3 = COR_NEON; b.TextColor3 = COR_FUNDO end)  
        b.MouseButton1Up:Connect(function() direcoes[dirNome] = false; b.BackgroundColor3 = COR_FUNDO; b.TextColor3 = COR_NEON end)  
        b.MouseLeave:Connect(function() direcoes[dirNome] = false; b.BackgroundColor3 = COR_FUNDO; b.TextColor3 = COR_NEON end)  
    end  

    CriarSeta(UDim2.new(0, 85, 0, screenH - 220), "▲", "cima")  
    CriarSeta(UDim2.new(0, 20, 0, screenH - 155), "◄", "esq")  
    CriarSeta(UDim2.new(0, 85, 0, screenH - 90), "▼", "baixo")  
    CriarSeta(UDim2.new(0, 150, 0, screenH - 155), "►", "dir")  
    CriarSeta(UDim2.new(1, -80, 0, screenH - 220), "⬆", "subir")  
    CriarSeta(UDim2.new(1, -80, 0, screenH - 90), "⬇", "descer")  
end  

criarToggle(AbaP, "Fly (Mobile Controls)", 2, function(ativo)  
    flyAtivo = ativo  
    if ativo then  
        CriarControlesFly()  
        flyConn = RunService.RenderStepped:Connect(function()  
            if not flyAtivo then return end  
            local char = LP.Character  
            if not char then return end  
            local root = char:FindFirstChild("HumanoidRootPart")  
            local hum = char:FindFirstChildOfClass("Humanoid")  
            if not root or not hum then return end  
            hum.PlatformStand = true  
            local cam = workspace.CurrentCamera  
            local dir = Vector3.new(0, 0, 0)  
            if direcoes.cima then dir += cam.CFrame.LookVector end  
            if direcoes.baixo then dir -= cam.CFrame.LookVector end  
            if direcoes.esq then dir -= cam.CFrame.RightVector end  
            if direcoes.dir then dir += cam.CFrame.RightVector end  
            if direcoes.subir then dir += Vector3.new(0, 1, 0) end  
            if direcoes.descer then dir -= Vector3.new(0, 1, 0) end  
            root.Velocity = dir.Magnitude > 0 and (dir.Unit * 120) or Vector3.new(0, 0, 0)  
        end)  
    else  
        if flyConn then flyConn:Disconnect(); flyConn = nil end  
        local char = LP.Character  
        if char then  
            local hum = char:FindFirstChildOfClass("Humanoid")  
            if hum then hum.PlatformStand = false end  
            local root = char:FindFirstChild("HumanoidRootPart")  
            if root then root.Velocity = Vector3.new(0, 0, 0) end  
        end  
        for k, _ in pairs(direcoes) do direcoes[k] = false end  
        DestruirControlesFly()  
    end  
end)  

-- ==================== FLY PC ====================  
local flyPCActive = false  
local flyPCConn, flyPCBV  
criarToggle(AbaP, "Fly (PC - WASD)", 3, function(ativo)  
    flyPCActive = ativo  
    if ativo then  
        local char = LP.Character  
        local hum = char and char:FindFirstChildOfClass("Humanoid")  
        local root = char and char:FindFirstChild("HumanoidRootPart")  
        if not root or not hum then return end  
        hum.PlatformStand = true  
        flyPCBV = Instance.new("BodyVelocity")  
        flyPCBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)  
        flyPCBV.Velocity = Vector3.zero  
        flyPCBV.Parent = root  

        flyPCConn = RunService.Heartbeat:Connect(function()  
            if not flyPCActive then return end  
            local c = LP.Character  
            local r = c and c:FindFirstChild("HumanoidRootPart")  
            if not r then return end  
            local cam = workspace.CurrentCamera  
            local vel = Vector3.zero  
            local speed = 80  
            if UIS:IsKeyDown(Enum.KeyCode.W) then vel += cam.CFrame.LookVector * speed end  
            if UIS:IsKeyDown(Enum.KeyCode.S) then vel -= cam.CFrame.LookVector * speed end  
            if UIS:IsKeyDown(Enum.KeyCode.A) then vel -= cam.CFrame.RightVector * speed end  
            if UIS:IsKeyDown(Enum.KeyCode.D) then vel += cam.CFrame.RightVector * speed end  
            if UIS:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.new(0, speed, 0) end  
            flyPCBV.Velocity = vel  
        end)  
    else  
        if flyPCConn then flyPCConn:Disconnect(); flyPCConn = nil end  
        if flyPCBV then flyPCBV:Destroy(); flyPCBV = nil end  
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")  
        if hum then hum.PlatformStand = false end  
    end  
end)  

-- ==================== FOCUS ====================  
local focusActive = false  
local focusConn = nil  
local focusTarget = nil  

local function findNearest()  
    local c = LP.Character  
    local r = c and c:FindFirstChild("HumanoidRootPart")  
    if not r then return nil end  
    local best, bestD = nil, math.huge  
    for _, p in ipairs(Players:GetPlayers()) do  
        if p ~= LP and p.Character then  
            local tr = p.Character:FindFirstChild("HumanoidRootPart")  
            local hum = p.Character:FindFirstChildOfClass("Humanoid")  
            if tr and hum and hum.Health > 0 then  
                local d = (tr.Position - r.Position).Magnitude  
                if d < bestD then bestD = d; best = p end  
            end  
        end  
    end  
    return best  
end  

local function stopFocus()  
    if focusConn then focusConn:Disconnect(); focusConn = nil end  
    local char = LP.Character  
    local hum = char and char:FindFirstChildOfClass("Humanoid")  
    if hum then hum.PlatformStand = false end  
    focusTarget = nil  
end  

local function startFocus()  
    focusTarget = findNearest()  
    if not focusTarget then focusActive = false return end  
    local angle = 0  
    local radius = 6  
    local speed = 5  
    local heightOffset = 3  

    focusConn = RunService.Heartbeat:Connect(function(dt)  
        if not focusActive then return end  
        if not focusTarget or not focusTarget.Character or not focusTarget.Character.Parent then  
            focusTarget = findNearest() if not focusTarget then return end  
        end  
        local char = LP.Character  
        local root = char and char:FindFirstChild("HumanoidRootPart")  
        local hum  = char and char:FindFirstChildOfClass("Humanoid")  
        local tr   = focusTarget.Character:FindFirstChild("HumanoidRootPart")  
        local tHum = focusTarget.Character:FindFirstChildOfClass("Humanoid")  
        if not root or not hum or not tr then return end  
        if tHum and tHum.Health <= 0 then focusTarget = findNearest() return end  
        hum.PlatformStand = true  
        angle += dt * speed  
        local offset = Vector3.new(math.cos(angle) * radius, heightOffset, math.sin(angle) * radius)  
        root.CFrame = CFrame.new(tr.Position + offset, tr.Position)  
        root.Velocity = Vector3.zero  
    end)  
end  

criarToggle(AbaP, "Focus (Player)", 4, function(ativo)  
    focusActive = ativo  
    if ativo then startFocus() else stopFocus() end  
end)  

-- ==================== ESP ====================  
local espActive = false  
local espFolder = nil  

local function IniciarESP()  
    if not espFolder then  
        espFolder = Instance.new("Folder")  
        espFolder.Name = "DinoESP"  
        espFolder.Parent = CoreGui  
    end  
    task.spawn(function()  
        while espActive do  
            espFolder:ClearAllChildren()  
            for _, p in ipairs(Players:GetPlayers()) do  
                if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then  
                    local h = Instance.new("Highlight")  
                    h.Adornee = p.Character  
                    h.FillColor = COR_NEON  
                    h.OutlineColor = Color3.fromRGB(255, 255, 255)  
                    h.FillTransparency = 0.5  
                    h.Parent = espFolder  
                end  
            end  
            task.wait(1)  
        end  
        if espFolder then espFolder:ClearAllChildren() end  
    end)  
end  

criarToggle(AbaP, "👁️ ESP (Ver Players)", 5, function(ativo)  
    espActive = ativo  
    if ativo then IniciarESP() else if espFolder then espFolder:ClearAllChildren() end end  
end)  

-- ==================== AUTO KOKUSEN ====================  
local kokusenActive = false  
local kokusenConn = nil  
criarToggle(AbaP, "🖤 Auto Kokusen (Spam Tool)", 6, function(ativo)  
    kokusenActive = ativo  
    if ativo then  
        kokusenConn = task.spawn(function()  
            while kokusenActive do  
                local char = LP.Character  
                local tool = char and char:FindFirstChildOfClass("Tool")  
                if tool then  
                    pcall(function() tool:Activate() end)  
                end  
                task.wait(0.03)  
            end  
        end)  
    else  
        if kokusenConn then task.cancel(kokusenConn); kokusenConn = nil end  
    end  
end)  

-- ==================== AUTO BYPASS (agora na Principal) ====================  
local bypassActive = false  
local bypassConn = nil  

local function ExecutarBypass()  
    local char = LP.Character or LP.CharacterAdded:Wait()  
    local root = char:WaitForChild("HumanoidRootPart", 5)  
    if not root then return false end  

    local sucesso = false  
    pcall(function()  
        local jogadores = Players:GetPlayers()  
        for i = #jogadores, 1, -1 do  
            if jogadores[i] == LP then table.remove(jogadores, i) end  
        end  
        if #jogadores > 0 then  
            local alvo = jogadores[math.random(1, #jogadores)]  
            if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then  
                local posAlvo = alvo.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)  
                root.CFrame = CFrame.new(posAlvo)  
                task.wait(0.5)  
                if root and root.Parent and (root.Position - posAlvo).Magnitude < 25 then  
                    sucesso = true  
                end  
            end  
        end  
    end)  
    return sucesso  
end  

local function rotaDoVoid()  
    pcall(function()  
        local char = LP.Character  
        local root = char and char:FindFirstChild("HumanoidRootPart")  
        local hum  = char and char:FindFirstChildOfClass("Humanoid")  
        if not root or not hum then return end  
        hum.PlatformStand = true  
        local bv = Instance.new("BodyVelocity")  
        bv.MaxForce = Vector3.new(9e6, 9e6, 9e6)  
        bv.Velocity = Vector3.new(0, 150, 0)  
        bv.Parent = root  
        task.wait(1.3)  
        bv.Velocity = Vector3.new(-300, 0, 0)  
        task.wait(2.4)  
        bv.Velocity = Vector3.zero  
        hum.PlatformStand = false  
        bv:Destroy()  
    end)  
end  

criarToggle(AbaP, "Auto Bypass", 7, function(ativo)  
    bypassActive = ativo  
    if ativo then  
        bypassConn = task.spawn(function()  
            while bypassActive do  
                local sucesso = ExecutarBypass()  
                if sucesso then  
                    bypassActive = false  
                    print("✅ Bypass FUNCIONOU!")  
                    break  
                else  
                    rotaDoVoid()  
                    task.wait(3)  
                end  
            end  
            bypassActive = false  
        end)  
    else  
        if bypassConn then task.cancel(bypassConn); bypassConn = nil end  
    end  
end)  

