local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local LP = Players.LocalPlayer

-- Limpeza
for _, n in ipairs({"DinoKey", "DinoHub", "DinoFlyControls", "DinoESP"}) do
pcall(function()
local g = CoreGui:FindFirstChild(n)
if g then g:Destroy() end
end)
end

local loadMainHub

-- ==================== KEY SYSTEM ====================
local function createKeyGui()
local gui = Instance.new("ScreenGui")
gui.Name = "DinoKey"
gui.ResetOnSpawn = false
gui.Parent = CoreGui

local frame = Instance.new("Frame")  
frame.Size = UDim2.new(0, 320, 0, 230)  
frame.Position = UDim2.new(0.5, -160, 0.5, -115)  
frame.BackgroundColor3 = COR_FUNDO  
frame.BorderSizePixel = 0  
frame.Active = true  
frame.Draggable = true  
frame.Parent = gui  
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 16)  

local stroke = Instance.new("UIStroke")  
stroke.Color = COR_NEON  
stroke.Thickness = 1.5  
stroke.Parent = frame  

local title = Instance.new("TextLabel")  
title.Size = UDim2.new(1, 0, 0, 45)  
title.Position = UDim2.new(0, 0, 0, 14)  
title.BackgroundTransparency = 1  
title.Text = "🦖 DINO HUB | KEY"  
title.TextColor3 = COR_NEON  
title.Font = Enum.Font.GothamBold  
title.TextSize = 22  
title.Parent = frame  

local sub = Instance.new("TextLabel")  
sub.Size = UDim2.new(1, 0, 0, 18)  
sub.Position = UDim2.new(0, 0, 0, 60)  
sub.BackgroundTransparency = 1  
sub.Text = "Digite a Key de Acesso"  
sub.TextColor3 = COR_TXT_DIM  
sub.Font = Enum.Font.Gotham  
sub.TextSize = 12  
sub.Parent = frame  

local box = Instance.new("TextBox")  
box.Size = UDim2.new(0, 250, 0, 40)  
box.Position = UDim2.new(0.5, -125, 0, 92)  
box.BackgroundColor3 = COR_FUNDO_2  
box.BorderSizePixel = 0  
box.Text = ""  
box.PlaceholderText = "Digite sua key..."  
box.TextColor3 = Color3.fromRGB(220, 255, 230)  
box.PlaceholderColor3 = COR_TXT_DIM  
box.Font = Enum.Font.Gotham  
box.TextSize = 14  
box.ClearTextOnFocus = false  
box.Parent = frame  
Instance.new("UICorner", box).CornerRadius = UDim.new(0, 10)  
local boxStroke = Instance.new("UIStroke")  
boxStroke.Color = COR_NEON  
boxStroke.Thickness = 1  
boxStroke.Transparency = 0.4  
boxStroke.Parent = box  

local btn = Instance.new("TextButton")  
btn.Size = UDim2.new(0, 250, 0, 40)  
btn.Position = UDim2.new(0.5, -125, 0, 142)  
btn.BackgroundColor3 = COR_NEON  
btn.BorderSizePixel = 0  
btn.Text = "VERIFICAR"  
btn.TextColor3 = COR_FUNDO  
btn.Font = Enum.Font.GothamBold  
btn.TextSize = 15  
btn.AutoButtonColor = false  
btn.Parent = frame  
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)  

local status = Instance.new("TextLabel")  
status.Size = UDim2.new(1, 0, 0, 18)  
status.Position = UDim2.new(0, 0, 0, 192)  
status.BackgroundTransparency = 1  
status.Text = ""  
status.TextColor3 = Color3.fromRGB(255, 80, 100)  
status.Font = Enum.Font.Gotham  
status.TextSize = 12  
status.Parent = frame  

local function tryVerify()  
    local k = box.Text  
    if k == "" then  
        status.Text = "Digite uma key!"  
        return  
    end  
    if k ~= KEY_CORRETA then  
        status.Text = "❌ Key inválida"  
        box.Text = ""  
        return  
    end  
    status.Text = "✅ Acesso Concedido"  
    status.TextColor3 = COR_NEON  
    btn.Text = "OK!"  
    btn.BackgroundColor3 = COR_NEON_ESCURO  
    task.wait(0.9)  
    gui:Destroy()  
    _G.DinoAuthenticated = true  
    loadMainHub()  
end  

btn.MouseButton1Click:Connect(tryVerify)  
box.FocusLost:Connect(function(enter)  
    if enter then tryVerify() end  
end)

end

